<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window background matches the Compose background so launch never flashes. -->
    <style name="Theme.HamSprint" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="launch_background">#FFF3F3F7</color>
</resources>
